#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
#  DASHBOARD.command — форвардер. Реализация одна: hub.js (см. HUB.command).
#
#  Раньше звал routing/restart-dashboard.sh — то есть на маке двойной клик всегда
#  означал ПЕРЕЗАПУСК: живой стек гасился целиком, включая front-door, даже если
#  человек просто хотел открыть дашборд. Теперь это `start`, и он идемпотентен —
#  поднимается только то, что лежит.
#
#  Полное меню (стоп, перезапуск, обновление, диагностика) — HUB.command.
# ─────────────────────────────────────────────────────────────────────────────
cd "$(dirname "$0")" || exit 1
chmod +x HUB.command 2>/dev/null
exec bash HUB.command start "$@"
