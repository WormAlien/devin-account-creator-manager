# Template for freemodel/.env. Copy this to .env and fill in real values.
# .env is gitignored; .env.example IS committed.
#
# Нужно только для EMAIL_BACKEND='timeweb' (catch-all + IMAP).
# Для backend='tmailor' (tmailor.com через Camoufox) этот файл не требуется.
#
# Схема: покупаешь домен, у почтового хостера включаешь catch-all на один
# ящик-ридер. Любой адрес *@ТВОЙ-ДОМЕН падает туда, автореген читает по IMAP
# и фильтрует письма по получателю.

# IMAP ящика-ридера (куда catch-all сваливает всю почту).
TW_IMAP_HOST=imap.example.com
TW_IMAP_PORT=993
TW_IMAP_USER=catch@example.com
TW_IMAP_PASS=

# Домен, на котором генерируются адреса регистрации.
# Можно переключать на лету в дашборде (пишет в freemodel/.email_domain).
# Список доступных доменов для дропдауна — FM_EMAIL_DOMAINS через запятую.
TW_MAIL_DOMAIN=example.com
FM_EMAIL_DOMAINS=example.com

# Базовый URL для кнопки "скопировать export-блок" в дашборде.
# По умолчанию http://localhost:20130/v1 (локальный fm-прокси).
FM_API_BASE=
